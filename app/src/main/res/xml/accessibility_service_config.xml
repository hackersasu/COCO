<?xml version="1.0" encoding="utf-8"?>
<!-- COCO 접근성 서비스 설정 (PRD 7.1) -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/coco_service_description"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked|typeViewScrolled|typeViewTextChanged"
